// Default signing for anyone building from source: ad hoc, no team.
// Signing.local.xcconfig (gitignored) overrides these for a Developer ID build.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
OTHER_CODE_SIGN_FLAGS =
#include? "Signing.local.xcconfig"
